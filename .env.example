# Local PostgreSQL example; use the connection string supplied by Neon/Supabase on Render.
DATABASE_URL=postgresql://bankguard:replace-me@localhost:5432/bankguard

# Optional. Leave empty to use deterministic rules without AI analysis.
GROQ_API_KEY=

# Replace with a long, random secret before enabling signed webhooks.
HMAC_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins; add the deployed frontend origin on Render.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.com

# Browser-visible URL of the backend; set this in the frontend deployment environment.
NEXT_PUBLIC_API_URL=http://localhost:8000
